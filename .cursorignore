# Cursor Ignore File
# Excludes generated code, vendor directories, build artifacts, and change logs

# =============================================================================
# Generated Code
# =============================================================================

# Go generated files
**/*_gen.go
**/wire_gen.go

# TypeScript/JavaScript generated files
**/*.gen.ts
**/*.gen.js

# Schema and spec generated files
**/types.spec.gen.ts
**/types.status.gen.ts
**/types.metadata.gen.ts

# Dashboard schema generated files
packages/grafana-schema/src/raw/**/*_types.gen.ts
pkg/kinds/**/*_spec_gen.go

# =============================================================================
# Vendor Directories
# =============================================================================

vendor/
node_modules/

