packages/**/dist/
packages/**/compiled/
packages/**/.rpt2_cache/
packages/**/tsdoc-metadata.json
packages/**/package.tgz

# Plugin dist folders
public/app/plugins/**/dist/

# E2E and test plugin builds
e2e-playwright/test-plugins/*/dist/

# Go build outputs
/grafana
pkg/cmd/grafana-cli/grafana-cli
pkg/cmd/grafana-server/grafana-server
pkg/cmd/grafana-server/debug
pkg/cmd/grafana-server/__debug_bin

# Scripts build outputs
scripts/go/bin/

